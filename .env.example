ARP_DATABASE_URL=sqlite+pysqlite:///./.arp/dev.db
ARP_SEED_ACTOR_USER_ID=00000000-0000-0000-0000-000000000001
ARP_API_BASE_URL=http://127.0.0.1:8000
# development_header is only for the local demo. Set api_key and provide a
# JSON token-to-user UUID map in deployed environments.
ARP_AUTH_MODE=development_header
# ARP_API_TOKENS='{"replace-with-a-long-random-token":"00000000-0000-0000-0000-000000000001"}'
# Optional runtime telemetry endpoint, for example localhost:4317.
# ARP_OTEL_ENDPOINT=localhost:4317
